    <string name="about_tech_gnss_label">GNSS:</string>
    <string name="about_tech_sensors_label">Sensors:</string>
    <string name="about_tech_sensors_text">Compass from accelerometer and magnetometer</string>
    <string name="about_tech_map_label">Map:</string>
    <string name="about_tech_map_text">handed over to an installed map app</string>
