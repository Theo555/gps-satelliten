    <!-- Über die App -->
    <string name="about_title">About this app</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_version_code">Version %1$s · build %2$d</string>
    <string name="about_intro">This app was built by a 70-year-old developer out of frustration with bloated, ad-ridden and data-hungry apps. It is a plain tool for GNSS enthusiasts and geocachers.</string>
    <string name="about_privacy_label" formatted="false">100 % privacy:</string>
    <string name="about_privacy_text">No internet permission, no trackers. Location, waypoints and tracks stay on the device.</string>
    <string name="about_honest_label">Honest data:</string>
    <string name="about_honest_text">What the hardware does not deliver is shown as “–”. No invented values.</string>
    <string name="about_free_label">Free &amp; open:</string>
    <string name="about_free_text">Fully usable – no ads, no subscriptions.</string>
    <string name="about_raw_title">Raw data &amp; measurement</string>
    <string name="about_raw_para">The Measurement tab shows the raw measurements of the GNSS chip for each satellite and frequency band. The CSV export automatically contains the last 60 seconds; for longer series there is “Record 5 min”. How many values arrive depends on the device: with poor reception or in the chip\'s power-saving mode, code lock, TOW or entire signals are missing.</string>
    <string name="about_raw_more_label">More raw data:</string>
    <string name="about_raw_more_text">Android\'s developer options offer “Force full GNSS measurements”. That makes the chip track fully all the time – at the cost of battery life.</string>
    <string name="about_pseudorange_label">Pseudorange:</string>
    <string name="about_pseudorange_text">Only computed when the time base is valid. For GLONASS and BeiDou it therefore stays empty – the app does not guess.</string>
    <string name="about_docs_title">Documentation &amp; project</string>
    <string name="about_docs_para">The explanations here are deliberately short and work without a network. Deeper details – raw data export and CSV columns, profiles, build instructions, requirements – are in the README on GitHub.</string>
    <string name="about_docs_btn">Full documentation (README)</string>
    <string name="about_tech_title">Technical details</string>
    <string name="about_tech_lang_label">Language &amp; UI:</string>
